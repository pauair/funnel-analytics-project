      <aliases enabled='yes' />
      <column caption='Views' datatype='integer' name='[Calculation_0204002044866560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([view]) THEN 1 ELSE 0 END' />
      </column>
      <column caption='Total Sessions' datatype='integer' name='[Calculation_0204002051072005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([user_session])' />
      </column>
      <column caption='View to Cart Rate' datatype='real' default-format='p0.00%' name='[Calculation_0204002051198982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Reached View (copy)_0204002045009921]) / SUM([Calculation_0204002044866560])' />
      </column>
      <column caption='Cart to Purchase Rate' datatype='real' default-format='p0.00%' name='[Calculation_0204002051309575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Reached Cart (copy)_0204002045181954]) / SUM([Reached View (copy)_0204002045009921])' />
      </column>
      <column caption='Overall to Purchase Rate' datatype='real' default-format='p0.00%' name='[Calculation_0204002051477512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Reached Cart (copy)_0204002045181954]) / SUM([Calculation_0204002044866560])' />
      </column>
      <column caption='Purchases' datatype='integer' name='[Reached Cart (copy)_0204002045181954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [valid_funnel_order] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Carts' datatype='integer' name='[Reached View (copy)_0204002045009921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([view])&#13;&#10;AND NOT ISNULL([cart])&#13;&#10;AND [view] &lt;= [cart]&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
